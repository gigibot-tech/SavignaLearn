# Copy to `.env` for local runs. Never commit real secrets.
#
# Netlify: set EXPO_PUBLIC_* on the *build* (they are inlined into the client).
# Set OPENAI_API_KEY as a *runtime* env var for netlify/functions/server
# (Expo `/api/openai/chat` does not run from static files). See docs/setup/netlify.md.

# SavignaLearn chat DB (leave empty to keep in-memory demo chat).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# AI backend: demo | onprem | openai | foursome | ido  (switchable in Chat settings)
EXPO_PUBLIC_AI_BACKEND=demo

# iDO AI — same Supabase project as ido-core. Used only for `ai-assist` (not SavignaLearn chat tables).
EXPO_PUBLIC_IDO_SUPABASE_URL=https://your-ido-project.supabase.co
EXPO_PUBLIC_IDO_SUPABASE_ANON_KEY=your-anon-key-here

# fourSome identity — same Auth project as the fourSome app (not SavignaLearn chat tables).
EXPO_PUBLIC_FOURSOME_SUPABASE_URL=https://your-foursome-project.supabase.co
EXPO_PUBLIC_FOURSOME_SUPABASE_ANON_KEY=your-anon-key-here

# OpenAI via `/api/openai/chat`. Put a *valid* key in OPENAI_API_KEY (server).
# The fourSome *frontend* EXPO_PUBLIC_OPENAI_API_KEY is often revoked → 401.
EXPO_PUBLIC_OPENAI_API_KEY=
OPENAI_API_KEY=
EXPO_PUBLIC_OPENAI_MODEL=gpt-4o-mini

# On-prem OpenAI-compatible chat (vLLM / Ollama). fourSome gigi_engine primary.
# Example: http://127.0.0.1:8000/v1  or  http://127.0.0.1:11434/v1
EXPO_PUBLIC_ONPREM_CHAT_URL=
EXPO_PUBLIC_ONPREM_MODEL=gpt-4o-mini
EXPO_PUBLIC_ONPREM_API_KEY=

# Optional GiGi WebSocket (only used as last hop when fourSome is selected + UUID set).
EXPO_PUBLIC_CHAT_COMPLETION_URL=https://p01--four-some-backend--yjfqr8lcxqgg.code.run/chat/
EXPO_PUBLIC_FOURSOME_USER_ID=
EXPO_PUBLIC_CHAT_COMPLETION_KEY=
EXPO_PUBLIC_USE_FOURSOME_AI=false

# In-browser Gemma 3 270M ONNX on desktop WebGPU. Loads in the tab after sign-in.
EXPO_PUBLIC_ENABLE_WEB_GEMMA=true
